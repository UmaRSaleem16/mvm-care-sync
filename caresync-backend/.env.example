# Django core
DJANGO_SETTINGS_MODULE=caresync.settings.development
SECRET_KEY=your-secret-key-change-in-production-must-be-50-chars-minimum
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite (dev default) or PostgreSQL
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://caresync:caresync_dev@localhost:5432/caresync

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email — use console backend for local dev, SMTP or SendGrid for staging/prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@mvmcaresync.com

# Optional — SendGrid API key (used when EMAIL_BACKEND=sendgrid)
SENDGRID_API_KEY=

# Celery / Redis (optional — required for async email tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── External integration placeholders ──────────────────────────────────────
# Future: MVM/NVM Portal connection
EXTERNAL_PORTAL_BASE_URL=
EXTERNAL_PORTAL_API_KEY=
EXTERNAL_PORTAL_WEBHOOK_SECRET=

# Future: Microsoft Teams webhook for notifications
TEAMS_WEBHOOK_URL=

# Future: Sentry error tracking
SENTRY_DSN=
