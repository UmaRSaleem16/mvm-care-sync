# ── Docker Compose environment ────────────────────────────────────────────
# Copy this to .env and fill in values before running docker compose up

# PostgreSQL
POSTGRES_DB=caresync
POSTGRES_USER=caresync
POSTGRES_PASSWORD=caresync_dev

# Django
SECRET_KEY=change-me-in-production-minimum-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS — origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Frontend URL used in password reset emails
FRONTEND_URL=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# App metadata (baked into the frontend bundle at build time)
VITE_APP_NAME=MVMCareSync
VITE_APP_VERSION=0.1.0
